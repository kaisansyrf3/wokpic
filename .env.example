# Salin file ini menjadi .env.local (atau .env) lalu isi nilainya. File .env*
# sudah ada di .gitignore.
# JANGAN menaruh komentar di baris yang sama dengan nilai: nilainya ikut terbaca.

# Supabase -- Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hanya dipakai di server (lib/supabase/admin.ts). Jangan pernah di-commit.
SUPABASE_SERVICE_ROLE_KEY=

# Gmail SMTP untuk form Contact. Pakai App Password 16 karakter, bukan password akun.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Tujuan pesan. Jika kosong, memakai GMAIL_USER.
CONTACT_TO_EMAIL=

# URL publik situs, untuk metadata dan Open Graph.
NEXT_PUBLIC_SITE_URL=
